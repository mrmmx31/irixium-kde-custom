  "baseline": "CLASSIC-BASELINE.json",
  "installation": {
    "path": "~/.local/share/plasma/desktoptheme/IrixClassicDomainOS",
    "scope": "current user only",
    "layout_application": "separate explicit per-user selection; no layout changes during installation"
  },
  "bevel": {
    "physical_margin": 4,
    "band_width": 1,
    "raised_top_outer_to_inner": [
      "#c5e8e6",
      "#7acac5",
      "#3e536e",
      "#a3d0e6"
    ],
    "raised_bottom_inner_to_outer": [
      "#7894a7",
      "#a3d0e6",
      "#3e536e",
      "#194b63"
    ],
    "sunken": "reverse opposing raised bands",
    "rendering": "opaque discrete pixels; no gradient, filter or animation"
  },
  "textures": {
    "instrument_weave": {
      "colors": [
        "#194b63",
        "#a3d0e6"
      ],
      "cell_pixels": 1,
      "period_pixels": [
        2,
        2
      ],
      "pattern": "alternating opaque dark/light checker cells"
    },
    "command_rail": {
      "colors": [
        "#3e536e",
        "#c4d5ed"
      ],
      "background_period_pixels": [
        2,
        2
      ],
      "groove_count": 4,
      "groove_rows": [
        "light",
        "alternating dark/light cells",
        "dark"
      ],
      "placement": "four centered grooves, dark cap above, light cap below; remaining rows retain the checker background",
      "center_scaling": "native stretch; hint-tile-center intentionally omitted to prevent vertical groove repetition",
      "rim": "four-pixel simple light top/left and dark bottom/right",
      "native_limit": "KSvg center stretching widens checker spacing and may interpolate colors; the panel QML supplies final-pixel checker frequency"
    }
  },
  "popup_palette": {
    "source": "Selected KDE application scheme; no style/colors override",
    "svg_role": "ColorScheme-Background",
    "relief": "four original one-pixel bands, opaque surface plus light/shadow overlays",
    "scope": "widgets/tooltip.svg and dialogs/background.svg only; approved panel art unchanged"
  },
  "runtime_colors": {
    "source": "selected KDE KColorScheme via native KSvg current-color-scheme roles",
    "fixed_reference_palette_rendered": false,
    "surfaces": [
      "Background",
      "HeaderBackground",
      "TooltipBackground",
      "ViewBackground",
      "ButtonBackground"
    ],
    "accents_and_glyphs": [
      "Highlight",
      "HighlightedText",
      "Text",
      "ButtonText",
      "TooltipText",
      "PositiveText",
      "NegativeText"
    ],
    "relief": "opaque thematic surface mixed with partial white/black mathematical endpoints; no independent hue"
  }
}
