# IrixClassic 0.1.0-rc1 — application style, not a window decoration.
# SPDX-FileCopyrightText: 2026 mrmmx31
# SPDX-License-Identifier: GPL-3.0-or-later
# Configuration derived from Irixium by Mark Whittaker (Phob1an).
# SVG primitives are newly drawn. See README.md for historical/adapted elements.
[%General]
author=mrmmx31
comment=IRIX Classic — compact Qt Widgets, integer bevels; test candidate 0.1.0-rc1
respect_DE=true
animate_states=false
button_contents_shift=false
composite=false
blurring=false
popup_blurring=false
translucent_windows=false
menu_shadow_depth=0
tooltip_shadow_depth=0
reduce_menu_opacity=0
reduce_window_opacity=0
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
active_tab_overlap=0
joined_inactive_tabs=false
no_inactive_tab_expansion=true
no_active_tab_separator=false
bold_active_tab=false
tab_button_extra_margin=0
group_toolbar_buttons=false
merge_menubar_with_toolbar=false
menubar_mouse_tracking=true
scrollable_menu=true
scroll_arrows=true
scrollbar_in_view=false
transient_scrollbar=false
transient_groove=false
scroll_width=18
scroll_min_extent=34
splitter_width=7
slider_width=14
slider_handle_width=16
slider_handle_length=26
check_size=15
layout_margin=3
layout_spacing=3
small_icon_size=16
button_icon_size=16
toolbar_icon_size=16
large_icon_size=32
toolbar_item_spacing=2
toolbar_interior_spacing=0
toolbutton_style=0
submenu_delay=250
submenu_overlap=1
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=false
square_combo_button=true
inline_spin_indicators=false
vertical_spin_indicators=false
spin_button_width=16
tree_branch_line=true
click_behavior=0
spread_progressbar=true
progressbar_thickness=18
no_inactiveness=true
tooltip_delay=-1

[GeneralColors]
window.color=#c1c1c1
window.text.color=#000000
base.color=#efefef
alt.base.color=#e0e0d8
button.color=#999999
button.text.color=#000000
light.color=#ececec
mid.light.color=#cccccc
mid.color=#919191
dark.color=#606060
text.color=#000000
disabled.text.color=#777777
highlight.color=#9ebfbf
inactive.highlight.color=#b3c3c3
highlight.text.color=#000000
link.color=#0000aa
link.visited.color=#660066
tooltip.base.color=#c1c1c1
tooltip.text.color=#000000
progress.indicator.text.color=#000000

[Hacks]
kinetic_scrolling=false
normal_default_pushbutton=false
no_selection_tint=true

[Window]
interior=true
interior.element=ic-window

[Dialog]
inherits=Window

[PanelButtonCommand]
frame=true
frame.element=ic-button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
interior=true
interior.element=ic-button
indicator.element=ic-arrow
indicator.size=12
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000
text.shadow=false
text.margin=true
text.margin.top=2
text.margin.bottom=2
text.margin.left=5
text.margin.right=5
text.iconspacing=4
min_height=22
focusFrame=false

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=ic-tool
interior.element=ic-tool
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
min_height=22

[GenericFrame]
inherits=PanelButtonCommand
frame.element=ic-common
interior=false
text.margin=false

[LineEdit]
inherits=PanelButtonCommand
frame.element=ic-entry
interior.element=ic-entry
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
min_height=22

[ComboBox]
inherits=LineEdit
indicator.element=ic-arrow-down
indicator.size=12

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=ic-arrow-down
indicator.size=12

[IndicatorArrow]
indicator.element=ic-arrow
indicator.size=12

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=ic-tool
interior.element=ic-tool
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=ic-arrow
indicator.size=12

[CheckBox]
inherits=PanelButtonCommand
interior.element=ic-check
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
min_height=18

[RadioButton]
inherits=CheckBox
interior.element=ic-radio

[Menu]
inherits=PanelButtonCommand
frame.element=ic-menu
interior.element=ic-menu
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[MenuItem]
inherits=PanelButtonCommand
frame.element=ic-menuitem
interior.element=ic-menuitem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=ic-arrow
indicator.size=12
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
min_height=20

[MenuBar]
inherits=Menu
frame.element=ic-bar
interior.element=ic-bar
text.normal.color=#000000

[MenuBarItem]
inherits=MenuItem
frame.element=ic-menubaritem
interior.element=ic-menubaritem
text.italic=true
text.margin.top=1
text.margin.bottom=1
min_height=20

[Toolbar]
inherits=MenuBar
indicator.element=ic-toolbar
indicator.size=10

[Tab]
inherits=PanelButtonCommand
frame.element=ic-tab
interior.element=ic-tab
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0
indicator.element=ic-tab
indicator.size=12
text.margin.top=1
text.margin.bottom=1
text.margin.left=6
text.margin.right=6
min_height=22

[TabFrame]
inherits=GenericFrame
frame.element=ic-tabframe
interior.element=ic-tabframe
interior=true

[TabBarFrame]
inherits=MenuBar
frame=false
interior.element=ic-window

[ToolboxTab]
inherits=PanelButtonCommand

[Dock]
inherits=GenericFrame

[DockTitle]
inherits=MenuBar
text.normal.color=#000000
text.focus.color=#000000
text.italic=true

[HeaderSection]
inherits=PanelButtonCommand
indicator.element=ic-arrow
indicator.size=12
text.margin.top=1
text.margin.bottom=1

[TreeExpander]
frame=false
interior=false
indicator.element=ic-tree
indicator.size=9

[GroupBox]
inherits=GenericFrame
frame.element=ic-group
interior=false
text.margin=false
text.bold=false

[ItemView]
inherits=PanelButtonCommand
frame=false
interior.element=ic-item
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2
min_height=18

[Scrollbar]
frame=false
interior=false
indicator.element=ic-scrollarrow
indicator.size=18

[ScrollbarGroove]
inherits=Menu
frame.element=ic-groove
interior.element=ic-groove

[ScrollbarSlider]
inherits=Menu
frame.element=ic-thumb
interior.element=ic-thumb
indicator.element=ic-grip
indicator.size=10

[Splitter]
inherits=Menu
frame.element=ic-bar
interior.element=ic-bar
indicator.element=ic-splitgrip
indicator.size=10

[Slider]
inherits=ScrollbarGroove

[SliderCursor]
inherits=ScrollbarSlider
frame.element=ic-slidercursor
interior.element=ic-slidercursor
indicator.element=ic-slidergrip
indicator.size=10

[Progressbar]
inherits=ScrollbarGroove
text.normal.color=#000000
text.focus.color=#000000
text.bold=false

[ProgressbarContents]
inherits=Menu
frame.element=ic-progress
interior.element=ic-progress

[ToolTip]
inherits=Menu

[Focus]
frame=true
frame.element=ic-focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=2
interior=false

[SizeGrip]
frame=false
interior=false
indicator.element=ic-sizegrip
indicator.size=15

[TitleBar]
inherits=MenuBar
text.normal.color=#000000
text.focus.color=#000000
text.italic=true
