# Native GtkEntry; KDE snapshot. Selection/clipboard stay native.
style "themeLabEntry-69a580f8e75b6cf9" {
  xthickness = 2
  ythickness = 2
  GtkEntry::inner-border = { 4, 4, 4, 4 }
  font_name = "13px"
  base[NORMAL] = "#ffffff"
  bg[NORMAL] = "#ffffff"
  text[NORMAL] = "#232629"
  fg[NORMAL] = "#232629"
  base[PRELIGHT] = "#ffffff"
  bg[PRELIGHT] = "#ffffff"
  text[PRELIGHT] = "#232629"
  fg[PRELIGHT] = "#232629"
  base[ACTIVE] = "#ffffff"
  bg[ACTIVE] = "#ffffff"
  text[ACTIVE] = "#232629"
  fg[ACTIVE] = "#232629"
  base[SELECTED] = "#3daee9"
  bg[SELECTED] = "#3daee9"
  text[SELECTED] = "#ffffff"
  fg[SELECTED] = "#ffffff"
  base[INSENSITIVE] = "#f3f3f3"
  bg[INSENSITIVE] = "#f3f3f3"
  text[INSENSITIVE] = "#aaabac"
  fg[INSENSITIVE] = "#aaabac"
  engine "pixmap" {
    image { function = SHADOW detail = "entry" state = NORMAL file = "entry-normal-8770717115fd233e.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = PRELIGHT file = "entry-normal-8770717115fd233e.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = ACTIVE file = "entry-normal-8770717115fd233e.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = SELECTED file = "entry-normal-8770717115fd233e.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = INSENSITIVE file = "entry-disabled-72deaf2c5a1b48fb.png" border = { 2, 2, 2, 2 } stretch = TRUE }
  }
}
widget "*themeLabEntry_69a580f8e75b6cf9" style : highest "themeLabEntry-69a580f8e75b6cf9"
