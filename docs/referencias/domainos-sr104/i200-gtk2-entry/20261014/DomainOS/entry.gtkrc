# Native GtkEntry; KDE snapshot. Selection/clipboard stay native.
style "themeLabEntry-151ebce5c2bc8abd" {
  xthickness = 2
  ythickness = 2
  GtkEntry::inner-border = { 4, 4, 4, 4 }
  font_name = "13px"
  base[NORMAL] = "#6688b5"
  bg[NORMAL] = "#6688b5"
  text[NORMAL] = "#ffffff"
  fg[NORMAL] = "#ffffff"
  base[PRELIGHT] = "#6688b5"
  bg[PRELIGHT] = "#6688b5"
  text[PRELIGHT] = "#ffffff"
  fg[PRELIGHT] = "#ffffff"
  base[ACTIVE] = "#6688b5"
  bg[ACTIVE] = "#6688b5"
  text[ACTIVE] = "#ffffff"
  fg[ACTIVE] = "#ffffff"
  base[SELECTED] = "#3297c7"
  bg[SELECTED] = "#3297c7"
  text[SELECTED] = "#ffffff"
  fg[SELECTED] = "#ffffff"
  base[INSENSITIVE] = "#6182ad"
  bg[INSENSITIVE] = "#6182ad"
  text[INSENSITIVE] = "#9fb5d2"
  fg[INSENSITIVE] = "#9fb5d2"
  engine "pixmap" {
    image { function = SHADOW detail = "entry" state = NORMAL file = "entry-normal-b014ec86b698be73.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = PRELIGHT file = "entry-normal-b014ec86b698be73.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = ACTIVE file = "entry-normal-b014ec86b698be73.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = SELECTED file = "entry-normal-b014ec86b698be73.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = INSENSITIVE file = "entry-disabled-99bbbb95f3399807.png" border = { 2, 2, 2, 2 } stretch = TRUE }
  }
}
widget "*themeLabEntry_151ebce5c2bc8abd" style : highest "themeLabEntry-151ebce5c2bc8abd"
