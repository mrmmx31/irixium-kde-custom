# Native GtkEntry; KDE snapshot. Selection/clipboard stay native.
style "themeLabEntry-08db77a94a468749" {
  xthickness = 2
  ythickness = 2
  GtkEntry::inner-border = { 4, 4, 4, 4 }
  font_name = "13px"
  base[NORMAL] = "#141618"
  bg[NORMAL] = "#141618"
  text[NORMAL] = "#fcfcfc"
  fg[NORMAL] = "#fcfcfc"
  base[PRELIGHT] = "#141618"
  bg[PRELIGHT] = "#141618"
  text[PRELIGHT] = "#fcfcfc"
  fg[PRELIGHT] = "#fcfcfc"
  base[ACTIVE] = "#141618"
  bg[ACTIVE] = "#141618"
  text[ACTIVE] = "#fcfcfc"
  fg[ACTIVE] = "#fcfcfc"
  base[SELECTED] = "#3daee9"
  bg[SELECTED] = "#3daee9"
  text[SELECTED] = "#fcfcfc"
  fg[SELECTED] = "#fcfcfc"
  base[INSENSITIVE] = "#131517"
  bg[INSENSITIVE] = "#131517"
  text[INSENSITIVE] = "#606263"
  fg[INSENSITIVE] = "#606263"
  engine "pixmap" {
    image { function = SHADOW detail = "entry" state = NORMAL file = "entry-normal-bb8c68acd27ca148.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = PRELIGHT file = "entry-normal-bb8c68acd27ca148.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = ACTIVE file = "entry-normal-bb8c68acd27ca148.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = SELECTED file = "entry-normal-bb8c68acd27ca148.png" border = { 2, 2, 2, 2 } stretch = TRUE }
    image { function = SHADOW detail = "entry" state = INSENSITIVE file = "entry-disabled-d6760dbb694969ec.png" border = { 2, 2, 2, 2 } stretch = TRUE }
  }
}
widget "*themeLabEntry_08db77a94a468749" style : highest "themeLabEntry-08db77a94a468749"
