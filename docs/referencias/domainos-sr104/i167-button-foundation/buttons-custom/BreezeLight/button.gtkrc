# Private GTK2 button proposal; RGB resolved from verified KDE roles.
style "theme-lab-gtk2-push" {
  xthickness = 3
  ythickness = 3
  GtkButton::inner-border = { 7, 7, 7, 7 }
  font_name = "18px"
  bg[NORMAL] = "#fcfcfc"
  fg[NORMAL] = "#232629"
  bg[PRELIGHT] = "#fcfcfc"
  fg[PRELIGHT] = "#232629"
  bg[ACTIVE] = "#fcfcfc"
  fg[ACTIVE] = "#232629"
  bg[SELECTED] = "#fcfcfc"
  fg[SELECTED] = "#232629"
  bg[INSENSITIVE] = "#f0f0f0"
  fg[INSENSITIVE] = "#a8a9aa"
  engine "pixmap" {
    image { function = BOX detail = "button" state = NORMAL file = "push-normal.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = PRELIGHT file = "push-normal.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = ACTIVE file = "push-pressed.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = SELECTED file = "push-normal.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = INSENSITIVE file = "push-disabled.png" border = { 3, 3, 3, 3 } stretch = TRUE }
  }
}
style "theme-lab-gtk2-push-backdrop" {
  xthickness = 3
  ythickness = 3
  GtkButton::inner-border = { 7, 7, 7, 7 }
  font_name = "18px"
  bg[NORMAL] = "#fcfcfc"
  fg[NORMAL] = "#232629"
  bg[PRELIGHT] = "#fcfcfc"
  fg[PRELIGHT] = "#232629"
  bg[ACTIVE] = "#fcfcfc"
  fg[ACTIVE] = "#232629"
  bg[SELECTED] = "#fcfcfc"
  fg[SELECTED] = "#232629"
  bg[INSENSITIVE] = "#f0f0f0"
  fg[INSENSITIVE] = "#a8a9aa"
  engine "pixmap" {
    image { function = BOX detail = "button" state = NORMAL file = "push-backdrop.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = PRELIGHT file = "push-backdrop.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = ACTIVE file = "push-backdrop.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = SELECTED file = "push-backdrop.png" border = { 3, 3, 3, 3 } stretch = TRUE }
    image { function = BOX detail = "button" state = INSENSITIVE file = "push-disabled.png" border = { 3, 3, 3, 3 } stretch = TRUE }
  }
}
widget "*themeLabPush" style : highest "theme-lab-gtk2-push"
widget "*themeLabPush.*" style : highest "theme-lab-gtk2-push"
widget "*themeLabBackdropPush" style : highest "theme-lab-gtk2-push-backdrop"
widget "*themeLabBackdropPush.*" style : highest "theme-lab-gtk2-push-backdrop"
