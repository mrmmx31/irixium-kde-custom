# Generated Irixium KDE color roles; original metrics, no engine or assets.
style "irixium-kde-default"
{
  bg[NORMAL] = "#c1c1c1"
  bg[PRELIGHT] = "#c1c1c1"
  bg[ACTIVE] = "#c1c1c1"
  bg[SELECTED] = "#648bb3"
  bg[INSENSITIVE] = "#919191"

  fg[NORMAL] = "#000000"
  fg[PRELIGHT] = "#000000"
  fg[ACTIVE] = "#000000"
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = "#606060"

  base[NORMAL] = "#c1c1c1"
  base[SELECTED] = "#648bb3"
  base[INSENSITIVE] = "#c1c1c1"

  text[NORMAL] = "#000000"
  text[SELECTED] = "#ffffff"
  text[INSENSITIVE] = "#606060"

  bg_pixmap[NORMAL] = ""
  bg_pixmap[PRELIGHT] = ""
  bg_pixmap[ACTIVE] = ""
  bg_pixmap[SELECTED] = ""
  bg_pixmap[INSENSITIVE] = ""
}

class "*" style : rc "irixium-kde-default"
widget_class "*" style : rc "irixium-kde-default"
widget "*GtkMenu*" style : rc "irixium-kde-default"
widget "*GtkMenuItem*" style : rc "irixium-kde-default"
widget "*GtkTreeView*" style : rc "irixium-kde-default"

gtk-color-scheme = "theme_bg_color:#c1c1c1\ntheme_fg_color:#000000\ntheme_base_color:#c1c1c1\ntheme_text_color:#000000\ntheme_selected_bg_color:#648bb3\ntheme_selected_fg_color:#ffffff\ntheme_tooltip_bg_color:#d0cfb2\ntheme_tooltip_fg_color:#000000"

style "irixium-kde-button" = "irixium-kde-default" {
  bg[NORMAL] = "#c1c1c1"
  fg[NORMAL] = "#000000"
  bg[PRELIGHT] = "#c1c1c1"
  fg[PRELIGHT] = "#000000"
  bg[ACTIVE] = "#c1c1c1"
  fg[ACTIVE] = "#000000"
  bg[SELECTED] = "#648bb3"
  fg[SELECTED] = "#ffffff"
  bg[INSENSITIVE] = "#919191"
  fg[INSENSITIVE] = "#606060"
}
class "GtkButton" style : rc "irixium-kde-button"
widget_class "*<GtkButton>*" style : rc "irixium-kde-button"
style "irixium-kde-tooltip" = "irixium-kde-default" {
  bg[NORMAL] = "#d0cfb2"
  fg[NORMAL] = "#000000"
}
widget "gtk-tooltip*" style : rc "irixium-kde-tooltip"
style "irixium-kde-header" = "irixium-kde-default" {
  bg[NORMAL] = "#c1c1c1"
  fg[NORMAL] = "#000000"
  bg[PRELIGHT] = "#648bb3"
  bg[ACTIVE] = "#648bb3"
  fg[PRELIGHT] = "#ffffff"
  fg[ACTIVE] = "#ffffff"
}
class "GtkMenuBar" style : rc "irixium-kde-header"
style "irixium-kde-menu-selection" = "irixium-kde-default" {
  bg[PRELIGHT] = "#648bb3"
  fg[PRELIGHT] = "#ffffff"
  bg[ACTIVE] = "#648bb3"
  fg[ACTIVE] = "#ffffff"
}
widget_class "*<GtkMenuItem>*" style : rc "irixium-kde-menu-selection"
widget "*GtkMenuItem*" style : rc "irixium-kde-menu-selection"
widget "*GtkMenuBar*" style : rc "irixium-kde-header"
