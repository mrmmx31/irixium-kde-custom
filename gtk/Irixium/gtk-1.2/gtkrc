style "irixium-gtk1"
{
  fg[NORMAL] = "#000000"
  bg[NORMAL] = "#c1c1c1"
  base[NORMAL] = "#c1c1c1"
  text[NORMAL] = "#000000"

  fg[SELECTED] = "#ffffff"
  bg[SELECTED] = "#648bb3"
  base[SELECTED] = "#648bb3"
  text[SELECTED] = "#ffffff"

  fg[INSENSITIVE] = "#606060"
  bg[INSENSITIVE] = "#919191"
  base[INSENSITIVE] = "#c1c1c1"
  text[INSENSITIVE] = "#606060"
}

widget_class "*" style "irixium-gtk1"
widget "*" style "irixium-gtk1"
